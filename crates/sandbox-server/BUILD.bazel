load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "sandbox_server",
    # utoipa reads these at compile time to fill the spec's contact and license, as
    # Cargo sets them from Cargo.toml. Without them the Bazel spec differs, and the
    # openapi contract test fails. The test keeps these values honest.
    rustc_env = {
        "CARGO_PKG_AUTHORS": "Frontal Labs",
        "CARGO_PKG_LICENSE": "Apache-2.0",
    },
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-scheduler:sandbox_scheduler",
        "//crates/sandbox-session:sandbox_session",
        "//crates/sandbox-vfs:sandbox_vfs",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:axum",
        "@crates//:tower",
        "@crates//:hyper",
        "@crates//:utoipa",
        "@crates//:argon2",
        "@crates//:uuid",
        "@crates//:blake3",

        "//crates/sandbox-trace:sandbox_trace",
        "//crates/sandbox-cas:sandbox_cas",
        "@crates//:tokio-stream",
],
    proc_macro_deps = [
    ],
    visibility = ["//visibility:public"],
)

# The spec generator. Writes openapi/v1/ (run from a Cargo checkout; the Bazel
# build only compiles it).
rust_binary(
    name = "gen_openapi",
    edition = "2021",
    srcs = ["src/bin/gen_openapi.rs"],
    deps = [":sandbox_server"],
)

# Dependencies of the integration tests. Each file in tests/ is its own crate, so
# each one lists what it uses, as Cargo's dev-dependencies do.
_SERVER_TEST_DEPS = [
    ":sandbox_server",
    "//crates/sandbox-cas:sandbox_cas",
    "//crates/sandbox-scheduler:sandbox_scheduler",
    "//crates/sandbox-session:sandbox_session",
    "//crates/sandbox-trace:sandbox_trace",
    "//crates/sandbox-types:sandbox_types",
    "//crates/sandbox-vfs:sandbox_vfs",
    "@crates//:axum",
    "@crates//:bytes",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:tokio",
    "@crates//:tower",
    "@crates//:utoipa",
]

# Unit tests in src/ (the lib compiled with cfg(test)).
rust_test(
    name = "sandbox_server_unit_test",
    crate = ":sandbox_server",
    edition = "2021",
    deps = [
        "@crates//:tower",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)

# Contract tests read the committed spec at openapi/v1 through CARGO_MANIFEST_DIR,
# which only Cargo sets. rustc_env supplies the same value, relative to the runfiles
# root, and data puts the spec files in the runfiles.
[
    rust_test(
        name = "sandbox_server_%s_test" % name,
        srcs = ["tests/%s.rs" % name],
        crate_root = "tests/%s.rs" % name,
        edition = "2021",
        data = ["//openapi:v1_spec"],
        rustc_env = {"CARGO_MANIFEST_DIR": "crates/sandbox-server"},
        deps = _SERVER_TEST_DEPS,
        visibility = ["//visibility:public"],
    )
    for name in [
        "durable",
        "durable_limits",
        "gc",
        "idle",
        "limits",
        "openapi",
        "rest",
    ]
]
