load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "cli_lib",
    edition = "2021",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    deps = [
        "//sdks/rust:sandbox_sdk",
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-session:sandbox_session",
        "//crates/sandbox-worker:sandbox_worker",
        "//crates/sandbox-server:sandbox_server",
        "//crates/sandbox-scheduler:sandbox_scheduler",
        "@crates//:axum",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:clap",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:serde_json",

        "//crates/sandbox-vfs:sandbox_vfs",
        "//crates/sandbox-trace:sandbox_trace",
        "//crates/sandbox-runtime:sandbox_runtime",
],
    proc_macro_deps = [
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "frontal-sandbox",
    edition = "2021",
    srcs = ["src/main.rs"],
    deps = [
        ":cli_lib",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "sandbox_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":frontal-sandbox",
        "@crates//:tokio",
    ],
    testonly = True,
)
