{
  "name": "@frontal-labs/sandbox",
  "private": true,
  "description": "Instant, low-cost execution environments for AI agents",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cargo:build": "cargo build --release --workspace",
    "cargo:test": "cargo test --workspace",
    "cargo:check": "cargo check --workspace",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings",
    "cargo:fmt": "cargo fmt --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=20.0.0"
  }
}
