load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_runtime",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-vfs:sandbox_vfs",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:deno_core",

        "@crates//:deno_console",
        "@crates//:deno_web",
        "@crates//:deno_url",
        "@crates//:deno_webidl",
        "@crates//:swc_core",
],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_runtime_warm_isolates_test",
    srcs = ["tests/warm_isolates.rs"],
    crate_root = "tests/warm_isolates.rs",
    edition = "2021",
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-vfs:sandbox_vfs",
        "@crates//:bytes",
        "@crates//:deno_console",
        "@crates//:deno_core",
        "@crates//:deno_url",
        "@crates//:deno_web",
        "@crates//:deno_webidl",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:swc_core",
        "@crates//:thiserror",
        "@crates//:tracing",
        ":sandbox_runtime",
        "@crates//:tokio",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Unit tests in src/ (the lib compiled with cfg(test)).
rust_test(
    name = "sandbox_runtime_unit_test",
    crate = ":sandbox_runtime",
    edition = "2021",
    visibility = ["//visibility:public"],
)
