load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# Root BUILD.bazel - workspace-level configuration

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # Apache 2.0

# Custom platform for Intel Mac (x86_64-apple-darwin)
platform(
    name = "x86_64_apple_darwin",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

# Filegroup for all source files
filegroup(
    name = "all_sources",
    srcs = glob([
        "**/*.rs",
        "**/*.toml",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.py",
        "**/*.md",
        "**/*.bzl",
        "**/BUILD.bazel",
        "**/MODULE.bazel",
        "**/.bazelrc",
    ], exclude = [
        "**/node_modules/**",
        "**/target/**",
        "**/.git/**",
    ], allow_empty = True),
)

# Test targets for the whole workspace
alias(
    name = "test_all",
    actual = "//crates/sandbox-types:sandbox_types_test",
    visibility = ["//visibility:public"],
)

alias(
    name = "build_all",
    actual = "//cli:sandbox",
    visibility = ["//visibility:public"],
)

# Build all Rust crates
alias(
    name = "build_rust",
    actual = "//crates/sandbox-server:sandbox_server",
    visibility = ["//visibility:public"],
)

# Build all SDKs
alias(
    name = "build_sdks",
    actual = "//sdks/typescript:sandbox_sdk",
    visibility = ["//visibility:public"],
)

# Test all Rust crates
alias(
    name = "test_rust",
    actual = "//crates/sandbox-types:sandbox_types_test",
    visibility = ["//visibility:public"],
)

# Build all benchmarks
alias(
    name = "build_benches",
    actual = "//benchmarks:all_benches",
    visibility = ["//visibility:public"],
)

# Test all TypeScript
alias(
    name = "test_ts",
    actual = "//sdks/typescript:test",
    visibility = ["//visibility:public"],
)

# Test all Python
alias(
    name = "test_py",
    actual = "//sdks/python:sandbox_sdk_test",
    visibility = ["//visibility:public"],
)

# Test all
alias(
    name = "test",
    actual = "//:test_all",
    visibility = ["//visibility:public"],
)