load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_trace",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:object_store",

        "//crates/sandbox-vfs:sandbox_vfs",
],
    proc_macro_deps = [
    ],
    visibility = ["//visibility:public"],
)

# Integration tests in tests/ (the lib used as a dependency).
rust_test(
    name = "sandbox_trace_format_test",
    crate_root = "tests/format.rs",
    edition = "2021",
    srcs = ["tests/format.rs"],
    deps = [
        ":sandbox_trace",
        "//crates/sandbox-types:sandbox_types",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_trace_replay_test",
    crate_root = "tests/replay.rs",
    edition = "2021",
    srcs = ["tests/replay.rs"],
    deps = [
        ":sandbox_trace",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)
