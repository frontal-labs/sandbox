load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_shell",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-vfs:sandbox_vfs",
        "//crates/sandbox-runtime:sandbox_runtime",
        "//crates/sandbox-wasm:sandbox_wasm",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:parking_lot",
        "@crates//:serde",

        "@crates//:regex",
],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_shell_conformance_test",
    srcs = ["tests/conformance.rs"],
    crate_root = "tests/conformance.rs",
    edition = "2021",
    deps = [
        "@crates//:serde_json",
        "//crates/sandbox-cas:sandbox_cas",
        ":sandbox_shell",
        "@crates//:tokio",
