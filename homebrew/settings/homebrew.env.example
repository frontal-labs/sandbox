# HOMEBREW_* environment variables for this machine.
# Copy this file to homebrew.env and fill in values as needed.
# Do NOT commit secrets; tokens live in keychain/CI secret store.

# Homebrew prefix
HOMEBREW_PREFIX=/opt/homebrew

# Disable analytics
HOMEBREW_NO_ANALYTICS=1

# Disable automatic updates
HOMEBREW_NO_AUTO_UPDATE=1

# Disable cleanup on install
HOMEBREW_NO_INSTALL_CLEANUP=1

# GitHub API token for brew (optional, for higher rate limits)
HOMEBREW_GITHUB_API_TOKEN=

# Cask options
HOMEBREW_CASK_OPTS=--no-quarantine
