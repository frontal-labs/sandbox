load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_server",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-scheduler:sandbox_scheduler",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:axum",
        "@crates//:tower",
        "@crates//:hyper",
        "@crates//:utoipa",
        "@crates//:jsonwebtoken",
        "@crates//:argon2",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "sandbox_server_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":sandbox_server",
        "@crates//:tokio",
    ],
    testonly = True,
)