load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_cas",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:blake3",
        "@crates//:zstd",
        "@crates//:object_store",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:futures",

        "@crates//:fastcdc",
],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Integration tests in tests/, one target per file.
rust_test(
    name = "sandbox_cas_disk_store_test",
    srcs = ["tests/disk_store.rs"],
    crate_root = "tests/disk_store.rs",
    edition = "2021",
    deps = [
        ":sandbox_cas",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:proptest",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_cas_mem_store_test",
    srcs = ["tests/mem_store.rs"],
    crate_root = "tests/mem_store.rs",
    edition = "2021",
    deps = [
        ":sandbox_cas",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_cas_tiered_store_test",
    srcs = ["tests/tiered_store.rs"],
    crate_root = "tests/tiered_store.rs",
    edition = "2021",
    deps = [
        ":sandbox_cas",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:bytes",
        "@crates//:object_store",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)
