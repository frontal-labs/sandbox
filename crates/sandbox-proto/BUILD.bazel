load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# build.rs compiles ../../proto with tonic-build. protoc comes from the
# protobuf module, so Cargo and Bazel use the same codegen path.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "PROTOC": "$(execpath @protobuf//:protoc)",
        "SANDBOX_PROTO_ROOT": "$(execpath //proto:buf_config)",
        # One path, so no whitespace splitting: the workspace path can contain spaces.
        "SANDBOX_PROTO_WKT": "$(location //proto:wkt/google/protobuf/empty.proto)",
    },
    data = [
        "@protobuf//:protoc",
        "//proto:buf_config",
        "//proto:protos",
        "//proto:wkt",
        "//proto:wkt/google/protobuf/empty.proto",
    ],
    deps = [
        "@crates//:tonic-build",
    ],
    edition = "2021",
)

rust_library(
    name = "sandbox_proto",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        ":build_script",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:blake3",
        "@crates//:bytes",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:tonic",
        "@crates//:ulid",
    ],
    visibility = ["//visibility:public"],
)

# Each file in tests/ is its own integration test crate, as in Cargo.
[
    rust_test(
        name = "sandbox_proto_%s_test" % name,
        srcs = ["tests/%s.rs" % name],
        crate_root = "tests/%s.rs" % name,
        edition = "2021",
        deps = [
            ":sandbox_proto",
            "//crates/sandbox-types:sandbox_types",
            "@crates//:blake3",
            "@crates//:prost",
            "@crates//:prost-types",
            "@crates//:ulid",
            "@crates//:proptest",
            "@crates//:serde",
            "@crates//:serde_json",
        ],
        data = ["//proto:protos"],
        visibility = ["//visibility:public"],
    )
    for name in ["roundtrip", "compat"]
]
