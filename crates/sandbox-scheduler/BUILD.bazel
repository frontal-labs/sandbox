load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_scheduler",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:redb",
        "@crates//:tonic",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Optional clustered feature
rust_library(
    name = "sandbox_scheduler_clustered",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        ":sandbox_scheduler",
        "@crates//:sqlx",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "sandbox_scheduler_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":sandbox_scheduler",
        "@crates//:tokio",
    ],
    testonly = True,
)