# Alias to run all benchmarks
alias(
    name = "all_benches",
    actual = ":vfs_bench",
    visibility = ["//visibility:public"],
)

# Test target for bench crate itself
rust_library(
    name = "bench_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":bench_common",
        "@rules_rust//cargo/remote:tokio",
    ],
    testonly = True,
)