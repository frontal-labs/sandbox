{
  "name": "@frontal-labs/sandbox-cli",
  "version": "0.1.0",
  "description": "Command-line client for Frontal Sandbox. Installs the prebuilt frontal-sandbox binary for this platform.",
  "keywords": [
    "sandbox",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontal-labs/sandbox.git",
    "directory": "npm/sandbox-cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "frontal-sandbox": "bin/sandbox.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "node scripts/build-binaries.mjs",
    "prepack": "cp ../../LICENSE.md ./LICENSE.md",
    "test": "node --test test/platform.test.js"
  },
  "optionalDependencies": {
    "@frontal-labs/sandbox-cli-aarch64-apple-darwin": "0.1.0",
    "@frontal-labs/sandbox-cli-aarch64-unknown-linux-gnu": "0.1.0",
    "@frontal-labs/sandbox-cli-x86_64-apple-darwin": "0.1.0",
    "@frontal-labs/sandbox-cli-x86_64-pc-windows-msvc": "0.1.0",
    "@frontal-labs/sandbox-cli-x86_64-unknown-linux-gnu": "0.1.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
