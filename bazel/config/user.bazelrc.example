# =============================================================================
# Per-machine Bazel settings (copy to bazel/config/user.bazelrc)
# =============================================================================
# bazel/config/user.bazelrc is git-ignored and imported by the root .bazelrc.
# Put settings here that differ between machines, such as a cache address or
# a local output directory. Do not put secrets here.
#   cp bazel/config/user.bazelrc.example bazel/config/user.bazelrc

# Point every --config=remote-cache build at a different cache.
# build:remote-cache --remote_cache=grpc://cache.internal.example:8980

# Use the remote cache on every build, without passing --config each time.
# build --config=remote-cache

# Keep a local disk cache outside the output base. .bazelrc does not expand
# $HOME or ~, so use an absolute path.
# build --disk_cache=/Users/you/.cache/bazel-disk

# On a machine whose home volume is nearly full, move Bazel's output root (the
# output bases and external repositories) to a volume with space. Bazel selects
# its server by output root, so after changing this, run `bazel shutdown` once.
# Setting this as a startup option in an rc file is unverified; passing
# --output_user_root on the command line is the tested route.
# startup --output_user_root=/Volumes/scratch/bazel-root
