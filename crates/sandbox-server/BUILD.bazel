load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "sandbox_server",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-scheduler:sandbox_scheduler",
        "//crates/sandbox-session:sandbox_session",
        "//crates/sandbox-vfs:sandbox_vfs",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:axum",
        "@crates//:tower",
        "@crates//:hyper",
        "@crates//:utoipa",
        "@crates//:argon2",
        "@crates//:uuid",
        "@crates//:blake3",

        "//crates/sandbox-trace:sandbox_trace",
        "//crates/sandbox-cas:sandbox_cas",
        "@crates//:tokio-stream",
],
    proc_macro_deps = [
    ],
    visibility = ["//visibility:public"],
)

# The spec generator. Writes openapi/v1/ (run from a Cargo checkout; the Bazel
# build only compiles it).
rust_binary(
    name = "gen_openapi",
    edition = "2021",
    srcs = ["src/bin/gen_openapi.rs"],
    deps = [":sandbox_server"],
)

# Contract tests (tests/openapi.rs) read openapi/v1 through CARGO_MANIFEST_DIR,
# which only Cargo sets. They run under `cargo test -p sandbox-server`.
