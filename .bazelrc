# Bazel configuration file

# Build configuration
build --color=yes
build --show_progress_rate_limit=30
build --keep_going
build --jobs=auto

# Test configuration
test --test_output=errors
test --test_timeout=300
test --runs_per_test=1
test --flaky_test_attempts=3
test --keep_going

# Platform configuration. The default target follows the host OS, so `bazel build //...`
# works on a Mac and on a Linux runner without flags. --config=linux_aarch64 and
# --config=linux_x86_64 still override it explicitly.
common --enable_platform_specific_config
build:macos --platforms=//bazel/platforms:x86_64_apple_darwin
build:linux --platforms=//bazel/platforms:x86_64_unknown_linux_gnu

# Execution platform. MODULE.bazel registers the Darwin platform first, so without this
# a Linux host picks Darwin toolchains (coreutils, tar) that cannot run there. The host
# platform is detected by Bazel, so it is correct on x86_64 and aarch64 alike, and it is
# tried before the registered ones.
common:macos --extra_execution_platforms=@bazel_tools//tools:host_platform
common:linux --extra_execution_platforms=@bazel_tools//tools:host_platform

build:linux_aarch64 --platforms=//bazel/platforms:aarch64_unknown_linux_gnu
build:linux_aarch64 --host_platform=//bazel/platforms:aarch64_unknown_linux_gnu
build:linux_aarch64 --extra_execution_platforms=//bazel/platforms:aarch64_unknown_linux_gnu
build:linux_x86_64 --platforms=//bazel/platforms:x86_64_unknown_linux_gnu
build:linux_x86_64 --host_platform=//bazel/platforms:x86_64_unknown_linux_gnu
build:linux_x86_64 --extra_execution_platforms=//bazel/platforms:x86_64_unknown_linux_gnu

# Worker isolation needs a delegated cgroup (ADR 0022). Tests forward the path that
# the Linux environment provides (docker/run-linux.sh sets it).
test:linux_aarch64 --test_env=SANDBOX_CGROUP_ROOT
test:linux_x86_64 --test_env=SANDBOX_CGROUP_ROOT

# Release configuration
build:release --compilation_mode=opt
build:release --strip=always
build:release --define=release=true

# Debug configuration
build:debug --compilation_mode=dbg
build:debug --strip=never

# Lint configuration
build --define=lint=1

# Common flags for all languages
common --noshow_loading_progress
common --show_timestamps
common --announce_rc

# Query configuration
query --output=label
query --order_output=no

# Test configuration
test --test_summary=detailed
test --noverbose_failures

# Shared settings live in bazel/config. try-import skips a missing file, so
# a fresh checkout still builds. Per-machine settings go in user.bazelrc, which
# is git-ignored.
try-import %workspace%/bazel/config/ci.bazelrc
try-import %workspace%/bazel/config/remote-cache.bazelrc
try-import %workspace%/bazel/config/user.bazelrc

# Coverage
coverage --combined_report=lcov
coverage --coverage_report_generator=@bazel_skylib//rules/coverage:lcov_merger
