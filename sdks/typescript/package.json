{
  "name": "@frontal-labs/sandbox-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the sandbox system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors/index.js",
      "types": "./dist/errors/index.d.ts"
    },
    "./embedded": {
      "import": "./dist/embedded/index.js",
      "types": "./dist/embedded/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "sandbox",
    "isolate",
    "wasm",
    "execution"
  ],
  "author": "Frontal Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sandbox.git",
    "directory": "sdks/typescript"
  },
  "files": [
    "dist",
    "!dist/tsbuildinfo.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ulid/ulid": "^0.1.0",
    "zod": "^4.6.7"
  }
}
