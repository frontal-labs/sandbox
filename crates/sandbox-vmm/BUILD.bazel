load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_vmm",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:reqwest",
        "@crates//:hyper",
        "@crates//:hyperlocal",
        "@crates//:rustix",
        "@crates//:nix",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
        "@crates//:tokio-util",
        "@crates//:which",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Optional seccomp feature
rust_library(
    name = "sandbox_vmm_seccomp",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:reqwest",
        "@crates//:hyper",
        "@crates//:hyperlocal",
        "@crates//:rustix",
        "@crates//:nix",
        "@crates//:seccompiler",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
        "@crates//:tokio-util",
        "@crates//:which",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    target_compatible_with = ["@platforms//os:linux"],
)
