load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_types",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    # Matches Cargo: the server enables the openapi feature for ToSchema derives.
    crate_features = ["openapi"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:ulid",
        "@crates//:blake3",
        "@crates//:bytes",
        "@crates//:utoipa",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "sandbox_types_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":sandbox_types",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
    testonly = True,
)
