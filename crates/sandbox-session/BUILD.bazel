load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_session",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-vfs:sandbox_vfs",
        "//crates/sandbox-cas:sandbox_cas",
        "//crates/sandbox-runtime:sandbox_runtime",
        "//crates/sandbox-wasm:sandbox_wasm",
        "//crates/sandbox-shell:sandbox_shell",
        "//crates/sandbox-policy:sandbox_policy",
        "@crates//:tokio",
        "@crates//:rustix",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:futures",

        "//crates/sandbox-trace:sandbox_trace",
],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Integration tests in tests/, one target per file.
rust_test(
    name = "sandbox_session_backend_test",
    srcs = ["tests/backend.rs"],
    crate_root = "tests/backend.rs",
    edition = "2021",
    deps = [
        ":sandbox_session",
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-vfs:sandbox_vfs",
        "//crates/sandbox-shell:sandbox_shell",
        "//crates/sandbox-runtime:sandbox_runtime",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_session_filesystem_test",
    srcs = ["tests/filesystem.rs"],
    crate_root = "tests/filesystem.rs",
    edition = "2021",
    deps = [
        ":sandbox_session",
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-trace:sandbox_trace",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_session_output_test",
    srcs = ["tests/output.rs"],
    crate_root = "tests/output.rs",
    edition = "2021",
    deps = [
        ":sandbox_session",
    ],
    visibility = ["//visibility:public"],
)
