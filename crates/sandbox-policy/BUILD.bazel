load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_policy",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:reqwest",
        "@crates//:rustls",
        "@crates//:webpki",
        "@crates//:ipnet",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "sandbox_policy_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":sandbox_policy",
        "@crates//:tokio",
    ],
    testonly = True,
)