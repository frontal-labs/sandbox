load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_guest",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:prost",
        "@crates//:prost-types",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Optional vsock feature
rust_library(
    name = "sandbox_guest_vsock",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        ":sandbox_guest",
        "@crates//:vsock",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "sandbox_guest_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":sandbox_guest",
        "@crates//:tokio",
    ],
    testonly = True,
)