load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_wasm",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-vfs:sandbox_vfs",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:wasmtime",
        "@crates//:futures",
        "@crates//:getrandom",
        "@crates//:toml",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_wasm_wasi_fs_test",
    srcs = ["tests/wasi_fs.rs"],
    crate_root = "tests/wasi_fs.rs",
    edition = "2021",
    compile_data = glob(["fixtures/**"]),
    deps = [
        ":sandbox_wasm",
        "//crates/sandbox-cas:sandbox_cas",
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-vfs:sandbox_vfs",
        "@crates//:tokio",
    ],
)
