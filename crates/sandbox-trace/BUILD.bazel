load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_trace",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:object_store",

        "//crates/sandbox-vfs:sandbox_vfs",
],
    proc_macro_deps = [
    ],
    visibility = ["//visibility:public"],
)

# Unit tests in src/ (the lib compiled with cfg(test)).
rust_test(
    name = "sandbox_trace_unit_test",
    crate = ":sandbox_trace",
    edition = "2021",
    visibility = ["//visibility:public"],
)
