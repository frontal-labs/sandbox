load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_cas",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:blake3",
        "@crates//:zstd",
        "@crates//:object_store",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:futures",

        "@crates//:fastcdc",
],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Unit tests in src/ (the lib compiled with cfg(test)).
rust_test(
    name = "sandbox_cas_unit_test",
    crate = ":sandbox_cas",
    edition = "2021",
    deps = ["@crates//:proptest"],
    visibility = ["//visibility:public"],
)
