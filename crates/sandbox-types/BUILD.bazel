load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_types",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    # Matches Cargo: the server enables the openapi feature for ToSchema derives.
    crate_features = ["openapi"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:ulid",
        "@crates//:blake3",
        "@crates//:bytes",
        "@crates//:utoipa",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Unit tests in src/ (the lib compiled with cfg(test)).
rust_test(
    name = "sandbox_types_unit_test",
    crate = ":sandbox_types",
    edition = "2021",
    visibility = ["//visibility:public"],
)
