{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@frontal-labs/sandbox-sdk": ["./packages/sdk-ts/src"],
      "@frontal-labs/sandbox-sdk/*": ["./packages/sdk-ts/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage", "target"]
}
