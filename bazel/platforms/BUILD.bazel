# Target platforms for this workspace.
#
# The build targets x86_64-apple-darwin only. The rusty_v8 archive in
# third_party/rusty_v8 and the crate_universe triples in MODULE.bazel are both
# darwin-specific, so no Linux platform exists here yet. Remote execution on
# Buildbarn's Linux workers therefore cannot run this build. See bazel/README.md.

package(default_visibility = ["//visibility:public"])

platform(
    name = "x86_64_apple_darwin",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

# Linux targets. The Linux V8 archives and crate triples are pinned in MODULE.bazel.
platform(
    name = "x86_64_unknown_linux_gnu",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "aarch64_unknown_linux_gnu",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)
