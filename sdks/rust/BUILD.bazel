load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_sdk",
    # The Cargo package is frontal-sandbox-sdk. cli and the tests import it by that
    # crate name, so Bazel uses the same one.
    crate_name = "frontal_sandbox_sdk",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:reqwest",
        "@crates//:futures",
    ],
    visibility = ["//visibility:public"],
)

# Unit tests in src/.
rust_test(
    name = "sandbox_sdk_unit_test",
    crate = ":sandbox_sdk",
    edition = "2021",
    visibility = ["//visibility:public"],
)

# tests/against_server.rs starts the real router on a local port.
rust_test(
    name = "sandbox_sdk_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"]),
    deps = [
        "@crates//:bytes",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:futures",
        ":sandbox_sdk",
        "//crates/sandbox-server:sandbox_server",
        "//crates/sandbox-scheduler:sandbox_scheduler",
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-session:sandbox_session",
        "@crates//:axum",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)
