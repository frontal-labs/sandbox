rust_test(
    name = "cli_worker_process_test",
    srcs = ["tests/worker_process.rs"],
    crate_root = "tests/worker_process.rs",
    edition = "2021",
    # The tests start the `sandbox` binary, which Bazel passes in as data.
    data = [":frontal-sandbox"],
    # The worker test reads CARGO_BIN_EXE_* at run time, which only Cargo sets. The
    # path is relative to the runfiles root, the test's working directory.
    env = {"CARGO_BIN_EXE_frontal-sandbox": "$(rootpath :frontal-sandbox)"},
    deps = [
        "//crates/sandbox-runtime:sandbox_runtime",
        "//crates/sandbox-scheduler:sandbox_scheduler",
        "//crates/sandbox-server:sandbox_server",
        "//crates/sandbox-session:sandbox_session",
        "//crates/sandbox-trace:sandbox_trace",
        "//crates/sandbox-vfs:sandbox_vfs",
        "//sdks/rust:sandbox_sdk",
        "@crates//:axum",
        "@crates//:clap",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        ":cli_lib",
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-worker:sandbox_worker",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)

# Contained `node` scripts: the real child process, with the host surviving scripts
# that exhaust memory. The tests start the `sandbox` binary, which Bazel passes in as data.
rust_test(
    name = "cli_contained_scripts_test",
    srcs = ["tests/contained_scripts.rs"],
    crate_root = "tests/contained_scripts.rs",
    edition = "2021",
    data = [":frontal-sandbox"],
    env = {"CARGO_BIN_EXE_frontal-sandbox": "$(rootpath :frontal-sandbox)"},
    deps = [
        "//crates/sandbox-runtime:sandbox_runtime",
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-worker:sandbox_worker",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)

