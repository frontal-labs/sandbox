load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_types",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    # Matches Cargo: the server enables the openapi feature for ToSchema derives.
    crate_features = ["openapi"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:ulid",
        "@crates//:blake3",
        "@crates//:bytes",
        "@crates//:utoipa",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Integration tests in tests/, one target per file.
rust_test(
    name = "sandbox_types_rfc3339_test",
    srcs = ["tests/rfc3339.rs"],
    crate_root = "tests/rfc3339.rs",
    edition = "2021",
    deps = [
        ":sandbox_types",
    ],
    visibility = ["//visibility:public"],
)
