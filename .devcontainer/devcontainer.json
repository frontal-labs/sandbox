{
  "name": "Frontal Sandbox",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=sandbox-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=sandbox-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=sandbox-target,target=${containerWorkspaceFolder}/target,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "biomejs.biome",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[json]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[typescript]": {
          "editor.defaultFormatter": "biomejs.biome"
        }
      }
    }
  },
  "postCreateCommand": "cargo fetch && bun install --frozen-lockfile"
}
