{
  "agentProfile": {
    "name": "Frontal Sandbox Engineer",
    "description": "Claude configured as an autonomous software engineer for Frontal Sandbox",
    "version": "1.0.0"
  },

  "behavior": {
    "inspectFirst": true,
    "planBeforeCode": true,
    "useSkillsProactively": true,
    "reuseExistingPatterns": true,
    "workInSmallSteps": true,
    "runTestsAfterChanges": true,
    "updateDocumentation": true,
    "preferParallelExecution": true,
    "verifyCompletion": true
  },

  "workflow": {
    "phases": ["exploration", "planning", "implementation", "validation", "completion"],
    "validationSteps": [
      "runRelevantTests",
      "checkTypes",
      "validateCodeQuality",
      "verifyFormatting",
      "manualVerificationIfNeeded"
    ]
  },

  "skillPreferences": {
    "autoLoad": true,
    "discovery": {
      "enabled": true,
      "method": "find-skills"
    },
    "preferredSources": [".claude/skills/", "../skills/"]
  },

  "project": {
    "name": "Frontal Sandbox",
    "description": "Rust-first, isolate-first execution platform for AI agents",
    "technologyStack": {
      "runtime": "Rust, V8, Wasmtime, and Firecracker",
      "language": "Rust with a thin TypeScript SDK",
      "transport": "HTTP + WebSocket",
      "storage": "Content-addressed snapshots",
      "isolation": "Capability-checked isolates and microVMs"
    },
    "importantPaths": {
      "crates": "./crates/",
      "plan": "./docs/MILESTONES.md",
      "docs": "./README.md"
    }
  },

  "commands": {
    "development": {
      "install": "bun install",
      "build": "bun run build",
      "dev": "bun run dev",
      "test": "bun run test",
      "testWatch": "bun run test --watch",
      "lint": "bun run lint",
      "lintFix": "bun run lint:fix",
      "format": "bun run format",
      "typecheck": "bun run typecheck"
    },
    "rust": {
      "build": "bun run cargo:build",
      "test": "bun run cargo:test",
      "check": "bun run cargo:check",
      "clippy": "bun run cargo:clippy",
      "fmt": "bun run cargo:fmt"
    }
  },

  "codeQuality": {
    "typescript": {
      "namingConvention": "camelCase",
      "interfacePrefix": "I",
      "maxLineLength": 100,
      "functionMaxLines": 50,
      "parameterMaxCount": 4
    },
    "rust": {
      "clippyEnabled": true,
      "fmtEnabled": true,
      "docCommentsRequired": true
    }
  },

  "commitMessage": {
    "type": "conventionalCommits",
    "scopes": ["agent", "model", "tools", "memory", "workflow", "runtime", "cli", "docs", "shared"]
  }
}
