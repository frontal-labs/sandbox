load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_worker",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-session:sandbox_session",
        "//crates/sandbox-proto:sandbox_proto",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tonic",
        "@crates//:prost",
        "@crates//:ulid",
        "@crates//:hyper-util",
        "@crates//:tower",
        "@crates//:nix",
        "@crates//:rustix",
    ] + select({
        # Namespaces, seccomp, and cgroups exist only on Linux (PLAN §4.13, ADR 0022).
        "@platforms//os:linux": [
            "@crates//:libc",
            "@crates//:seccompiler",
        ],
        "//conditions:default": [],
    }),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_worker_unit_test",
    crate = ":sandbox_worker",
    edition = "2021",
    visibility = ["//visibility:public"],
)
