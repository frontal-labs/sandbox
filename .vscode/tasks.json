{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build",
      "type": "shell",
      "command": "bun run cargo:build",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo: test",
      "type": "shell",
      "command": "bun run cargo:test",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo: check",
      "type": "shell",
      "command": "bun run cargo:check",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo: clippy",
      "type": "shell",
      "command": "bun run cargo:clippy",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo: fmt",
      "type": "shell",
      "command": "bun run cargo:fmt",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "biome: check",
      "type": "shell",
      "command": "bun run lint",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
