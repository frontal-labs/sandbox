load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Python SDK library. The pip packages come from the `pypi` hub, which
# MODULE.bazel builds from requirements_lock.txt.
py_library(
    name = "sandbox_sdk",
    srcs = glob(["sandbox_sdk/**/*.py"]),
    imports = ["."],
    deps = [
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//ulid_py",
        "@pypi//python_dotenv",
    ],
    visibility = ["//visibility:public"],
)

# Tests
py_test(
    name = "sandbox_sdk_test",
    srcs = ["tools/run_module.py"] + glob(["tests/**/*.py"], allow_empty = True),
    main = "tools/run_module.py",
    args = ["pytest", "-q", "tests"],
    deps = [
        ":sandbox_sdk",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_cov",
    ],
    visibility = ["//visibility:public"],
)

# Tools run as modules: `run_module.py mypy ...`, `run_module.py ruff ...`. A pip
# package's console script is not a file Bazel can name, but its module is.
py_binary(
    name = "typecheck",
    srcs = ["tools/run_module.py"],
    main = "tools/run_module.py",
    args = [
        "mypy",
        "--strict",
        "--warn-return-any",
        "--warn-unused-configs",
        "--disallow-untyped-defs",
        "--disallow-incomplete-defs",
        "--check-untyped-defs",
        "--no-implicit-optional",
        "--warn-redundant-casts",
        "--warn-unused-ignores",
        "--warn-no-return",
        "sandbox_sdk",
    ],
    deps = [
        ":sandbox_sdk",
        "@pypi//mypy",
        "@pypi//types_requests",
    ],
    visibility = ["//visibility:public"],
)

# Linting (ruff)
py_binary(
    name = "lint",
    srcs = ["tools/run_module.py"],
    main = "tools/run_module.py",
    args = ["ruff", "check", "sandbox_sdk", "tests"],
    deps = ["@pypi//ruff"],
    visibility = ["//visibility:public"],
)

# Format check
py_binary(
    name = "format_check",
    srcs = ["tools/run_module.py"],
    main = "tools/run_module.py",
    args = ["ruff", "format", "--check", "sandbox_sdk", "tests"],
    deps = ["@pypi//ruff"],
    visibility = ["//visibility:public"],
)

# Format fix
py_binary(
    name = "format_fix",
    srcs = ["tools/run_module.py"],
    main = "tools/run_module.py",
    args = ["ruff", "format", "sandbox_sdk", "tests"],
    deps = ["@pypi//ruff"],
    visibility = ["//visibility:public"],
)

# Alias for all checks
alias(
    name = "check",
    actual = ":typecheck",
    visibility = ["//visibility:public"],
)
