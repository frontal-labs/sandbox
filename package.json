{
  "name": "@frontal-labs/frontal-sandbox",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:types": "turbo run test:types",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "turbo run clean",
    "knip": "knip",
    "precommit:install": "pre-commit install --hook-type pre-commit --hook-type commit-msg",
    "precommit:run": "pre-commit run --all-files",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "ci:check": "turbo run lint typecheck build test",
    "cargo:build": "cargo build --release --workspace",
    "cargo:test": "cargo test --workspace",
    "cargo:check": "cargo check --workspace",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings",
    "cargo:fmt": "cargo fmt --check",
    "cargo:napi": "cargo build --release -p vibe_napi && node scripts/copy-napi.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^26.1.1",
    "knip": "^5.37.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/*",
    "vibe",
    "vibe-cli",
    "apps/*",
    "tools/generators",
    "examples/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
