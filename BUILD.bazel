load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# Root BUILD.bazel - workspace-level configuration

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # Apache 2.0

# The x86_64-apple-darwin platform is defined in bazel/platforms/BUILD.bazel.

# Filegroup for all source files
filegroup(
    name = "all_sources",
    srcs = glob([
        "**/*.rs",
        "**/*.toml",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.py",
        "**/*.md",
        "**/*.bzl",
        "**/BUILD.bazel",
        "**/MODULE.bazel",
        "**/.bazelrc",
    ], exclude = [
        "**/node_modules/**",
        "**/target/**",
        "**/.git/**",
    ], allow_empty = True),
)

# Test targets for the whole workspace
alias(
    name = "test_all",
    actual = ":test_rust",
    visibility = ["//visibility:public"],
)

alias(
    name = "build_all",
    actual = "//cli:sandbox",
    visibility = ["//visibility:public"],
)

# Build all Rust crates
alias(
    name = "build_rust",
    actual = "//crates/sandbox-server:sandbox_server",
    visibility = ["//visibility:public"],
)

# Build all SDKs
alias(
    name = "build_sdks",
    actual = "//sdks/typescript:sandbox_sdk",
    visibility = ["//visibility:public"],
)

# Test all Rust crates
test_suite(
    name = "test_rust",
    tests = [
        "//cli:cli_bench_process_test",
        "//cli:cli_serve_process_test",
        "//cli:cli_trace_process_test",
        "//cli:cli_worker_isolation_test",
        "//cli:cli_worker_process_test",
        "//crates/sandbox-proto:sandbox_proto_compat_test",
        "//crates/sandbox-proto:sandbox_proto_roundtrip_test",
        "//crates/sandbox-runtime:sandbox_runtime_warm_isolates_test",
        "//crates/sandbox-shell:sandbox_shell_conformance_test",
        "//crates/sandbox-shell:sandbox_shell_features_test",
        "//crates/sandbox-shell:sandbox_shell_globbing_test",
        "//crates/sandbox-shell:sandbox_shell_nesting_limit_test",
        "//crates/sandbox-shell:sandbox_shell_recursion_test",
        "//crates/sandbox-shell:sandbox_shell_streaming_test",
        "//crates/sandbox-shell:sandbox_shell_typescript_test",
        "//crates/sandbox-wasm:sandbox_wasm_wasi_fs_test",
        "//crates/sandbox-worker:sandbox_worker_unit_test",
        "//sdks/rust:sandbox_sdk_test",
        "//sdks/rust:sandbox_sdk_unit_test",
    ],
    visibility = ["//visibility:public"],
)

# Build all benchmarks
alias(
    name = "build_benches",
    actual = "//benchmarks:all_benches",
    # Manual: the benchmark helpers do not compile yet (PLAN.md open items).
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Test all TypeScript
# The TypeScript tests run with vitest (npm test), not Bazel yet. See sdks/typescript/BUILD.bazel.
alias(
    name = "test_ts",
    actual = "//sdks/typescript:sandbox_sdk",
    visibility = ["//visibility:public"],
)

# Test all Python
alias(
    name = "test_py",
    actual = "//sdks/python:sandbox_sdk_test",
    visibility = ["//visibility:public"],
)

# Test all
alias(
    name = "test",
    actual = "//:test_all",
    visibility = ["//visibility:public"],
)