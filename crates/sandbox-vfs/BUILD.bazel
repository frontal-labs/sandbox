load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "sandbox_vfs",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-cas:sandbox_cas",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:notify",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Integration tests in tests/ (the lib used as a dependency).
rust_test(
    name = "sandbox_vfs_vfs_test",
    crate_root = "tests/vfs.rs",
    edition = "2021",
    srcs = ["tests/vfs.rs"],
    deps = [
        ":sandbox_vfs",
        "//crates/sandbox-cas:sandbox_cas",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:serde_json",
        "@crates//:proptest",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "sandbox_vfs_diff_test",
    crate_root = "tests/diff.rs",
    edition = "2021",
    srcs = ["tests/diff.rs"],
    deps = [
        ":sandbox_vfs",
        "//crates/sandbox-cas:sandbox_cas",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
    ],
    visibility = ["//visibility:public"],
)
