load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "sandbox",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//sdks/rust:sandbox_sdk",
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:clap",
        "@crates//:thiserror",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "sandbox_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":sandbox",
        "@crates//:tokio",
    ],
    testonly = True,
)