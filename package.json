{
  "name": "frontal-sandbox",
  "private": true,
  "description": "Instant, low-cost execution environments for AI agents",
  "workspaces": [
    "sdks/typescript"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ts:build": "bazel build //sdks/typescript:all",
    "ts:test": "bazel test //sdks/typescript:test",
    "ts:lint": "bazel run //sdks/typescript:lint",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-sdk-versions.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=22.23.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
