load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_worker",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "//crates/sandbox-session:sandbox_session",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tonic",
        "@crates//:prost",
        "@crates//:rustix",
        "@crates//:nix",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Optional seccomp feature
rust_library(
    name = "sandbox_worker_seccomp",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        ":sandbox_worker",
        "@crates//:seccompiler",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "sandbox_worker_test",
    edition = "2021",
    srcs = glob(["tests/**/*.rs"], allow_empty = True),
    deps = [
        ":sandbox_worker",
        "@crates//:tokio",
    ],
    testonly = True,
)