load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "sandbox_scheduler",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:redb",
        "@crates//:tonic",
        "@crates//:serde_json",
        "@crates//:prost",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

# Optional clustered feature
rust_library(
    # The clustered variant: the same sources with the `clustered` feature, plus the Postgres driver.
    name = "sandbox_scheduler_clustered",
    crate_name = "sandbox_scheduler",
    crate_features = ["clustered"],
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//crates/sandbox-types:sandbox_types",
        "@crates//:tokio",
        "@crates//:bytes",
        "@crates//:tracing",
        "@crates//:thiserror",
        "@crates//:serde",
        "@crates//:redb",
        "@crates//:tonic",
        "@crates//:sqlx",
        "@crates//:serde_json",
        "@crates//:prost",
        "@crates//:uuid",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)
